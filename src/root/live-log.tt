<div data-live-log [% HTML.attributes('data-log-url' => c.uri_for('/_live/log' build.id, step ? {step => step.stepnr} : {}), 'data-log-finished' => build.finished, 'data-build-url' => c.uri_for('/build' build.id)) %]>
  <p class="d-flex align-items-center">
    <span class="text-monospace" data-log-status role="status">Connecting to build log...</span>
    <label class="ml-auto mb-0"><input type="checkbox" data-log-follow checked /> Follow output</label>
  </p>
  <p data-log-step class="text-muted small"></p>
  <div class="card bg-light"><div class="card-body p-2">
    <pre class="log mb-0" data-log-output tabindex="0" aria-label="Build log" style="max-height: 65vh; overflow: auto; white-space: pre-wrap;"></pre>
  </div></div>
  <p class="mt-2 mb-0"><a data-log-raw [% HTML.attributes(href => step ? c.uri_for('/build' build.id 'nixlog' step.stepnr 'raw') : c.uri_for('/build' build.id 'log' 'raw')) %]>Full raw log</a></p>
  <p class="text-muted small mt-2" data-log-notice></p>
</div>
